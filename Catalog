local function LoadSavedOutfit(data)
    if sharedEnv.__RobCatalogRunGeneration ~= thisRunGeneration then return end
    if type(data) ~= "table" then return end
    restoreGeneration += 1
    local thisRestoreGeneration = restoreGeneration
    data.Accessories = data.Accessories or {}
    data.Clothes = data.Clothes or {}
    data.Meshes = data.Meshes or {}

