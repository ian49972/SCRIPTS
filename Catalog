for _,v in ipairs(character:GetChildren()) do
    if (v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("CharacterMesh"))
        and (v:GetAttribute("CatalogId") ~= nil or v:GetAttribute("CatalogManaged") == true) then
        v:Destroy()
    end
end

    if type(data.OriginalAvatarItems) == "table" then
        local desiredCounts = {}
        for _, key in ipairs(data.OriginalAvatarItems) do desiredCounts[key] = (desiredCounts[key] or 0) + 1 end
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("CharacterMesh") then
                if item:GetAttribute("CatalogId") == nil and item:GetAttribute("CatalogManaged") ~= true then
                    local key = getOriginalAvatarItemKey(item)
                    if key then
                        if (desiredCounts[key] or 0) > 0 then
                            desiredCounts[key] -= 1
                        else
                            item:Destroy()
                        end
                    end
                end
            end
        end
    end

local head = character:FindFirstChild("Head")
if head then
	local mesh = head:FindFirstChildOfClass("SpecialMesh")
	if mesh then
		mesh:Destroy()
	end

	if originalHeadMesh then
		originalHeadMesh:Clone().Parent = head
	end
end

	if data.Clothes.Shirt then
        if sharedEnv.__RobCatalogRunGeneration ~= thisRunGeneration or thisRestoreGeneration ~= restoreGeneration or player.Character ~= character then
            if thisRestoreGeneration == restoreGeneration then isRestoringOutfit = false end
            return
        end
		tryOn({
			Id = data.Clothes.Shirt,
			Name = "Shirt",
			AssetType = "Shirt"
		}, character)
	end

	if data.Clothes.Pants then
        if sharedEnv.__RobCatalogRunGeneration ~= thisRunGeneration or thisRestoreGeneration ~= restoreGeneration or player.Character ~= character then
            if thisRestoreGeneration == restoreGeneration then isRestoringOutfit = false end
            return
        end
		tryOn({
			Id = data.Clothes.Pants,
			Name = "Pants",
			AssetType = "Pants"
		}, character)
	end

	if data.Clothes.TShirt then
        if sharedEnv.__RobCatalogRunGeneration ~= thisRunGeneration or thisRestoreGeneration ~= restoreGeneration or player.Character ~= character then
            if thisRestoreGeneration == restoreGeneration then isRestoringOutfit = false end
            return
        end
		tryOn({
			Id = data.Clothes.TShirt,
			Name = "T-Shirt",
			AssetType = "TShirt"
		}, character)
	end

	for _,acc in ipairs(data.Accessories) do
        if sharedEnv.__RobCatalogRunGeneration ~= thisRunGeneration or thisRestoreGeneration ~= restoreGeneration or player.Character ~= character then
            isRestoringOutfit = false
            return
        end
        if acc.Id then
            tryOn({
                Id = acc.Id,
                Name = acc.Name,
                AssetType = "Hat"
            }, character)
        end
    end

	if data.BodyColors then
		for partName,color in pairs(data.BodyColors) do

			local part = character:FindFirstChild(partName)

			if part then
