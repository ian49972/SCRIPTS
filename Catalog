	local function clearCardPreview()
		if rotationConnection then rotationConnection:Disconnect(); rotationConnection = nil end
		if activeViewport then activeViewport:Destroy(); activeViewport = nil end
		if activeWorld then activeWorld:Destroy(); activeWorld = nil end
