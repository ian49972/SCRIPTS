local function getAnimationSlot(item)
    local t = item and item.AssetType
    if type(t) == "table" then t = t.Id or t.id or t.Name end
    local n = tonumber(t)
    if not n and item and item.Type == "Asset" then n = tonumber(item.AssetTypeId) end
    if n then
        for _, slot in ipairs(animationSlots) do if slot.assetType == n then return slot end end
    end
    local name = string.lower(tostring((item and item.Name) or t or ""))
    for _, slot in ipairs(animationSlots) do if name:find(slot.label:lower(), 1, true) then return slot end end
    return nil
end

