local function attachAccessoryToPreview(character, accessory)
	local handle = accessory:FindFirstChild("Handle")
	if not handle or not handle:IsA("BasePart") then
		accessory:Destroy()
		return false
	end

	handle.Anchored = true
	handle.CanCollide = false
	accessory.Parent = character

	local accessoryAttachment
	for _, d in ipairs(handle:GetDescendants()) do
		if d:IsA("Attachment") then accessoryAttachment = d; break end
	end
	if accessoryAttachment then
		local bodyPart, bodyAttachment
		for _, d in ipairs(character:GetDescendants()) do
			if d:IsA("Attachment") and d.Name == accessoryAttachment.Name
				and d.Parent and d.Parent:IsA("BasePart") and d.Parent ~= handle then
				bodyPart, bodyAttachment = d.Parent, d
				break
			end
		end
		if bodyPart and bodyAttachment then
			for _, d in ipairs(handle:GetChildren()) do
				if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") then d:Destroy() end
			end
			handle.CFrame = bodyPart.CFrame * bodyAttachment.CFrame * accessoryAttachment.CFrame:Inverse()
			local weld = Instance.new("Weld")
			weld.Name = "PreviewAccessoryWeld"
			weld.Part0 = bodyPart
			weld.Part1 = handle
			weld.C0 = bodyAttachment.CFrame
			weld.C1 = accessoryAttachment.CFrame
			weld.Parent = handle
			return true, bodyPart, bodyAttachment, accessoryAttachment, weld
		end
	end

	local head = character:FindFirstChild("Head")
	if head then
		handle.CFrame = head.CFrame
		local weld = Instance.new("Weld")
		weld.Name = "PreviewAccessoryWeld"
		weld.Part0 = head
		weld.Part1 = handle
		weld.C0 = CFrame.new()
		weld.C1 = CFrame.new()
		weld.Parent = handle
		return true, head, nil, nil, weld
	end
	return false
end

local function applyItemToPreview(previewCharacter, item)
	local ok, asset = pcall(function()
		return game:GetObjects("rbxassetid://" .. tostring(item.Id))[1]
	end)
	if not ok or not asset then return end

	local humanoid = previewCharacter:FindFirstChildOfClass("Humanoid")
	if asset:IsA("Accessory") then
		attachAccessoryToPreview(previewCharacter, asset)
	elseif asset:IsA("Shirt") then
		local old = previewCharacter:FindFirstChildOfClass("Shirt")
		if old then old:Destroy() end
		asset.Parent = previewCharacter
	elseif asset:IsA("Pants") then
		local old = previewCharacter:FindFirstChildOfClass("Pants")
		if old then old:Destroy() end
		asset.Parent = previewCharacter
	elseif asset:IsA("ShirtGraphic") then
		local old = previewCharacter:FindFirstChildOfClass("ShirtGraphic")
		if old then old:Destroy() end
		asset.Parent = previewCharacter
	elseif asset:IsA("Model") then
		local accessory = asset:FindFirstChildWhichIsA("Accessory", true)
		if accessory and humanoid then
			accessory.Parent = nil
			asset:Destroy()
			attachAccessoryToPreview(previewCharacter, accessory)
		else
			asset.Parent = previewCharacter
		end
	else
		asset.Parent = previewCharacter
	end
end

