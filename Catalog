local function tryOn(item, targetCharacter)
    if sharedEnv.__RobCatalogRunGeneration ~= thisRunGeneration then return end
	local character = targetCharacter or player.Character or player.CharacterAdded:Wait()
	local typeName = tostring(item.AssetType):match("([^%.]+)$") or tostring(item.AssetType)

	for _, child in ipairs(character:GetChildren()) do
		if child:GetAttribute("CatalogId") == item.Id then
			return
		end
	end

	local head = character:FindFirstChild("Head")
	if head then
		local mesh = head:FindFirstChildOfClass("SpecialMesh")
		if mesh and mesh:GetAttribute("DisplayName") == item.Name then
			return
		end
	end

	local ok, asset = pcall(function()
		return game:GetObjects("rbxassetid://" .. tostring(item.Id))[1]
	end)
	if not ok or not asset then return end
    if sharedEnv.__RobCatalogRunGeneration ~= thisRunGeneration then asset:Destroy(); return end
	if targetCharacter and (player.Character ~= character or not character.Parent) then
		asset:Destroy()
		return
	end

	local function replaceClass(className)
		for _, child in ipairs(character:GetChildren()) do
			if child:IsA(className) then child:Destroy() end
		end
	end

	if typeName == "Shirt" then
		local shirt = asset:IsA("Shirt") and asset or asset:FindFirstChildWhichIsA("Shirt", true)
		if shirt then
			replaceClass("Shirt")
			if shirt ~= asset then asset:Destroy() end
			shirt:SetAttribute("DisplayName", item.Name)
			shirt:SetAttribute("CatalogId", item.Id)
			shirt.Parent = character
		else
			asset:Destroy()
			return
		end
	elseif typeName == "Pants" then
		local pants = asset:IsA("Pants") and asset or asset:FindFirstChildWhichIsA("Pants", true)
		if pants then
			replaceClass("Pants")
			if pants ~= asset then asset:Destroy() end
			pants:SetAttribute("DisplayName", item.Name)
			pants:SetAttribute("CatalogId", item.Id)
			pants.Parent = character
		else
			asset:Destroy()
			return
		end
	elseif typeName == "TShirt" then
		local graphic = asset:IsA("ShirtGraphic") and asset or asset:FindFirstChildWhichIsA("ShirtGraphic", true)
		if graphic then
			replaceClass("ShirtGraphic")
			if graphic ~= asset then asset:Destroy() end
			graphic:SetAttribute("DisplayName", item.Name)
			graphic:SetAttribute("CatalogId", item.Id)
			graphic.Parent = character
		else
			asset:Destroy()
			return
		end
	elseif typeName == "Face" then
		if head then
			local oldFace = head:FindFirstChild("face")
			if oldFace then oldFace:Destroy() end
			local decal = Instance.new("Decal")
			decal.Name = "face"
			decal.Texture = "rbxassetid://" .. tostring(item.Id)
			decal:SetAttribute("CatalogId", item.Id)
			decal:SetAttribute("DisplayName", item.Name)
			decal.Parent = head
		end
		asset:Destroy()
	else
		local accessory = asset:IsA("Accessory") and asset or asset:FindFirstChildWhichIsA("Accessory", true)
		if not accessory then
			asset:SetAttribute("CatalogId", item.Id)
			asset:SetAttribute("DisplayName", item.Name)
			asset.Parent = character
			if updateWearing then updateWearing() end
			if AutoSaveOutfit then AutoSaveOutfit() end
			return
		end
		if accessory ~= asset then
			accessory.Parent = nil
			asset:Destroy()
		end

		accessory:SetAttribute("CatalogId", item.Id)
		accessory:SetAttribute("DisplayName", item.Name)
		accessory.Parent = character

		local handle = accessory:FindFirstChild("Handle")
		if handle and handle:IsA("BasePart") then
			local accessoryAttachment = handle:FindFirstChildWhichIsA("Attachment")
			local characterAttachment
			if accessoryAttachment then
				for _, descendant in ipairs(character:GetDescendants()) do
					if descendant:IsA("Attachment")
						and descendant.Name == accessoryAttachment.Name
						and descendant ~= accessoryAttachment
						and descendant.Parent and descendant.Parent:IsA("BasePart")
						and descendant.Parent ~= handle then
						characterAttachment = descendant
						break
					end
				end
			end

			for _, child in ipairs(handle:GetChildren()) do
				if child:IsA("Weld") or child:IsA("WeldConstraint") or child:IsA("Motor6D") then
					child:Destroy()
				end
			end

			if accessoryAttachment and characterAttachment and characterAttachment:IsA("Attachment") and characterAttachment.Parent:IsA("BasePart") then
				handle.CFrame = characterAttachment.WorldCFrame * accessoryAttachment.CFrame:Inverse()
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = handle
				weld.Part1 = characterAttachment.Parent
				weld.Parent = handle
		else
				local fallbackHead = character:FindFirstChild("Head")
				if fallbackHead then
					handle.CFrame = fallbackHead.CFrame
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = handle
					weld.Part1 = fallbackHead
					weld.Parent = handle
				end
			end
			handle.Anchored = false
			handle.CanCollide = false
		end
	end

	if updateWearing then updateWearing() end
	if AutoSaveOutfit then AutoSaveOutfit() end
end

