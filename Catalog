local function resolveAnimationClips(item, slot)
    local clips = {}
    local assetId = animationAssetId(item)
    if not assetId:match("^%d+$") then return clips end
    local propertyByKey = {
        idle = "IdleAnimation", walk = "WalkAnimation", run = "RunAnimation",
        jump = "JumpAnimation", fall = "FallAnimation", climb = "ClimbAnimation", swim = "SwimAnimation",
    }
    local prop = propertyByKey[slot.key]
    if prop then
        pcall(function()
            local description = Instance.new("HumanoidDescription")
            description[prop] = tonumber(assetId)
            local dummy = game:GetService("Players"):CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
            local animate = dummy:FindFirstChild("Animate")
            local folderNames = {slot.folder}
            if slot.key == "swim" then folderNames = {"swim", "swimidle"} end
            if animate then
                for _, folderName in ipairs(folderNames) do
                    local folder = animate:FindFirstChild(folderName)
                    if folder then
                        for _, child in ipairs(folder:GetChildren()) do
                            if child:IsA("Animation") and child.AnimationId ~= "" then
                                clips[#clips+1] = {Name=child.Name, AnimationId=child.AnimationId}
                            end
                        end
                    end
                end
            end
            dummy:Destroy()
        end)
    end
    if #clips == 0 then
        pcall(function()
            local objects = game:GetObjects("rbxassetid://" .. assetId)
            for _, object in ipairs(objects or {}) do
                if object:IsA("Animation") and object.AnimationId ~= "" then
                    clips[#clips+1] = {Name=object.Name, AnimationId=object.AnimationId}
                end
                for _, child in ipairs(object:GetDescendants()) do
                    if child:IsA("Animation") and child.AnimationId ~= "" then
                        clips[#clips+1] = {Name=child.Name, AnimationId=child.AnimationId}
                    end
                end
                object:Destroy()
            end
        end)
    end
    return clips
end

local function applyAnimationSlots(slotMap)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum or hum.RigType ~= Enum.HumanoidRigType.R15 then return false, "R15 is required" end
    local animate = char:FindFirstChild("Animate") or char:WaitForChild("Animate", 4)
    if not animate then return false, "Animate script was not found" end
    for _, track in ipairs(hum:GetPlayingAnimationTracks()) do pcall(function() track:AdjustWeight(0, 0); track:Stop(0) end) end
    animate.Disabled = true
    for key, item in pairs(slotMap) do
        local slot
        for _, candidate in ipairs(animationSlots) do if candidate.key == key then slot = candidate; break end end
        local folders = {}
        if slot then
            local primary = animate:FindFirstChild(slot.folder)
            if primary then folders[#folders+1] = primary end
            if key == "swim" then
                local swimIdle = animate:FindFirstChild("swimidle")
                if swimIdle then folders[#folders+1] = swimIdle end
            end
        end
        local clips = item.ResolvedAnimations or {}
        if #clips == 0 then
            local fallbackId = animationAssetId(item)
            if fallbackId:match("^%d+$") then clips = {{Name="Animation1", AnimationId="rbxassetid://" .. fallbackId}} end
        end
        if #folders > 0 and #clips > 0 then
            for _, folder in ipairs(folders) do
                for _, child in ipairs(folder:GetChildren()) do if child:IsA("Animation") then child:Destroy() end end
                for i, clip in ipairs(clips) do
                    local a = Instance.new("Animation")
                    a.Name = clip.Name or ("Animation" .. i)
                    a.AnimationId = clip.AnimationId
                    a.Parent = folder
                end
                folder:SetAttribute("RobCatalogManagedAnimation", true)
            end
        end
    end
    task.wait(0.1)
    if animate.Parent then animate.Disabled = false end
    return true
end

