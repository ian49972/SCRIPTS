	local function showCardPreview(sequence)
		if sequence ~= previewSequence or not button.Parent then return end
		activeViewport = Instance.new("ViewportFrame")
		activeViewport.Name = "ItemAvatarPreview"
		activeViewport.Size = UDim2.new(1,-10,0,90)
		activeViewport.Position = UDim2.new(0,5,0,5)
		activeViewport.BackgroundTransparency = 1
		activeViewport.Ambient = Color3.fromRGB(200,200,200)
		activeViewport.LightColor = Color3.fromRGB(255,255,255)
		activeViewport.Parent = button
		image.Visible = false

		activeWorld = Instance.new("WorldModel")
		activeWorld.Parent = activeViewport
		activeCamera = Instance.new("Camera")
		activeCamera.FieldOfView = 35
		activeCamera.Parent = activeViewport
		activeViewport.CurrentCamera = activeCamera

		local character = player.Character
		if not character then
			character = player.CharacterAdded:Wait()
		end
		if sequence ~= previewSequence or not button.Parent then return end
		local wasArchivable = character.Archivable
		character.Archivable = true
		local clone = character:Clone()
		character.Archivable = wasArchivable
		if not clone then return end
		for _, descendant in ipairs(clone:GetDescendants()) do
			if descendant:IsA("Script") or descendant:IsA("LocalScript") or descendant:IsA("Animator") then
				descendant:Destroy()
			elseif descendant:IsA("BasePart") then
				descendant.Anchored = true
				descendant.CanCollide = false
				descendant.LocalTransparencyModifier = 0
			end
		end
		local humanoid = clone:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		end
		clone.Parent = activeWorld
		local root = clone:FindFirstChild("HumanoidRootPart")
		clone:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(180), 0))
		local boxCFrame, boxSize = clone:GetBoundingBox()
		clone:PivotTo(CFrame.new(-boxCFrame.Position) * clone:GetPivot())
		applyItemToPreview(clone, item)

		boxCFrame, boxSize = clone:GetBoundingBox()
		clone:PivotTo(CFrame.new(-boxCFrame.Position) * clone:GetPivot())
		boxCFrame, boxSize = clone:GetBoundingBox()
		local focus = Vector3.new(0, boxSize.Y * 0.03, 0)
		local viewportHeight = math.max(activeViewport.AbsoluteSize.Y, 90)
		local viewportWidth = math.max(activeViewport.AbsoluteSize.X, 90)
		local aspect = viewportWidth / viewportHeight
		local verticalFov = math.rad(activeCamera.FieldOfView)
		local horizontalFov = 2 * math.atan(math.tan(verticalFov / 2) * aspect)
		local distanceForHeight = (boxSize.Y * 0.62) / math.tan(verticalFov / 2)
		local distanceForWidth = (boxSize.X * 0.62) / math.tan(horizontalFov / 2)
		local distance = math.max(distanceForHeight, distanceForWidth, boxSize.Z * 1.5, 3.5)
		activeCamera.CFrame = CFrame.lookAt(focus + Vector3.new(0, boxSize.Y * 0.015, -distance), focus)

		local basePivot = clone:GetPivot()
		local angle = 0
		rotationConnection = RunService.RenderStepped:Connect(function(dt)
			if sequence ~= previewSequence or not clone.Parent or not activeViewport or not activeViewport.Parent then
				if rotationConnection then rotationConnection:Disconnect(); rotationConnection = nil end
				return
			end
			angle += dt * 0.7
			clone:PivotTo(CFrame.new(focus) * CFrame.Angles(0, angle, 0) * CFrame.new(-focus) * basePivot)
		end)
	end

	button.MouseButton1Click:Connect(function()
        if activeCatalogPreviewClear then activeCatalogPreviewClear() end
		previewSequence += 1
		local mySequence = previewSequence
