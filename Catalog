local function toggleFavorite(item)
    local key = favoriteKey(item)
    if key == "" then return end
    if Favorites[key] then
        Favorites[key] = nil
    else
        local rawAssetType = item.AssetType or currentAssetType
        local assetTypeName = tostring(rawAssetType):match("([^%.]+)$") or tostring(rawAssetType or "")
        Favorites[key] = {Id = tonumber(key) or key, Name = tostring(item.Name or ("Asset " .. key)), AssetType = assetTypeName}
    end
    SaveFavorites()
    refreshFavoritesTab()
end

