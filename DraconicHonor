       task.spawn(function()
         task.wait(9)
        loadstring(game:HttpGet("https://raw.githubusercontent.com/ian49972/smth/refs/heads/main/HonorCamS"))()
       end)

		task.delay(userAnim.Length, function()

			userAnim:Stop()
