local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer

local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

local connections = {}

local function Connect(sig, fn)
local conn = sig:Connect(fn)
table.insert(connections, conn)
return conn
end

local function Cleanup()
for _, conn in ipairs(connections) do
pcall(function() conn:Disconnect() end)
end
connections = {}
end

player.CharacterAdded:Connect(function(newChar)
Cleanup()
character = newChar
hrp = newChar:WaitForChild("HumanoidRootPart")
humanoid = newChar:WaitForChild("Humanoid")
end)

player.CharacterRemoving:Connect(Cleanup)


local tool = Instance.new("Tool")
tool.Name = "Draconic Honor"
tool.RequiresHandle = false
tool.Parent = player:WaitForChild("Backpack")

local asset = game:GetObjects(getcustomasset("MArtist.rbxmx"))[1]
asset.Parent = game.ReplicatedStorage

local AnimsFolder = asset:WaitForChild("Anims")

local DHonorStartKS = AnimsFolder:WaitForChild("DHonorStart")
