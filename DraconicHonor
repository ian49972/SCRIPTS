			local root = dragon:FindFirstChild("RootPart", true)
			local torso = character:FindFirstChild("HumanoidRootPart")

			if root and torso then
				root.Anchored = false

				dragon:PivotTo(hrp.CFrame * CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(180), 0))

				local weld = dragon:FindFirstChildWhichIsA("WeldConstraint", true)
