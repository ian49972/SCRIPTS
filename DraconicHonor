		clone.Parent = workspace

		local cHRP = clone:FindFirstChild("HumanoidRootPart")

if cHRP then
	-- place in front of player
	cHRP.CFrame = hrp.CFrame * CFrame.new(0, 0, -3) * CFrame.Angles(0, math.rad(180), 0)

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hrp
	weld.Part1 = cHRP
	weld.Parent = hrp
end

		local userAnim = PlayKeyframeSequence(character, DHonorKS, 1)
		local enemyAnim = PlayKeyframeSequence(clone, VHonorKS, 1)

     loadstring(game:HttpGet("https://raw.githubusercontent.com/ian49972/smth/refs/heads/main/HonorCam"))()

dragonRunAnim:Stop()
dragonStartAnim:Stop()

		if dragon then
			task.delay(9, function()
				if dragon then
					dragon:Destroy()
				end
			end)
		end


		task.delay(5, function()

			local dashBV = Instance.new("BodyVelocity")
			dashBV.MaxForce = Vector3.new(1e9, 0, 1e9)
			dashBV.Parent = hrp

			local conn
			local start = tick()

			conn = RunService.Heartbeat:Connect(function()

				if not dashBV or not dashBV.Parent then return end

				local cam = workspace.CurrentCamera
				local look = cam.CFrame.LookVector
				local flat = Vector3.new(look.X, 0, look.Z)

				if flat.Magnitude > 0 then
					flat = flat.Unit
					hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flat)
					dashBV.Velocity = flat * 100
				end

				if tick() - start >= 4 then
					conn:Disconnect()
