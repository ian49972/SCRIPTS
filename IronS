local function CloneCharacter(char)
	char.Archivable = true
	local clone = char:Clone()
	char.Archivable = false
	return clone
end

local function PerformIronOnslaught(victimChar)
	if not character or not character.Parent then return end

	local hrp = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChild("Humanoid")
	if not hrp or not humanoid then return end

	hrp.Anchored = true

	local victimClone = CloneCharacter(victimChar)
	victimClone.Name = victimChar.Name .. "_IronClone"
	victimClone.Parent = workspace

	local victimHrp = victimClone:FindFirstChild("HumanoidRootPart")
	if victimHrp then
		victimHrp.CFrame = hrp.CFrame * CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(180), 0)

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = hrp
		weld.Part1 = victimHrp
		weld.Parent = hrp
	end

	local ironUserAnim = PlayKeyframeSequence(character, IronUserKS, 1)

