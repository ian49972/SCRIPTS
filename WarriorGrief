loadstring(game:HttpGet("https://raw.githubusercontent.com/ian49972/Animator/refs/heads/main/RobAnimator"))()

local Player = game.Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local Existing = Player.Backpack:FindFirstChild("Awakening")
if Existing then Existing:Destroy() end

local Tool = Instance.new("Tool")
Tool.Name = "Warrior Grief"
Tool.RequiresHandle = false
Tool.CanBeDropped = false
Tool.Parent = Player.Backpack

local Asset = game:GetObjects(getcustomasset("Shinji.rbxmx"))[1]
local AnimsFolder = Asset:FindFirstChild("Anims")

local Debounce = false

Tool.Activated:Connect(function()
	if Debounce then return end
	Debounce = true

	local Character = Player.Character
	if not Character then Debounce = false return end

  Tool:Destroy()

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	local HRP = Character:FindFirstChild("HumanoidRootPart")

	if not Humanoid or not HRP then
		Debounce = false
		return
	end

	HRP.Anchored = true
	local originalSpeed = Humanoid.WalkSpeed
	Humanoid.WalkSpeed = 0

	task.spawn(function()
		task.wait(0.6)

		local Sound = Instance.new("Sound")
		Sound.SoundId = getcustomasset("Grief.mp3")
		Sound.Volume = 1
		Sound.Parent = workspace
		Sound:Play()
	end)

	local animAwakening = PlayKeyframeSequence(
		Character,
		AnimsFolder:FindFirstChild("Awakening", true),
		1
	)

	task.spawn(function()
		task.wait(0.5)
		loadstring(game:HttpGet("https://raw.githubusercontent.com/ian49972/smth/refs/heads/main/GriefCam"))()
	end)

	local shinjiModel = Asset:Clone()
	shinjiModel.Parent = Workspace

	local originalLighting = {
		ClockTime = Lighting.ClockTime,
		Brightness = Lighting.Brightness,
		FogStart = Lighting.FogStart,
		FogEnd = Lighting.FogEnd,
		FogColor = Lighting.FogColor,
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient
	}

	local insertedEffects = {}

	Lighting.ClockTime = 0
	Lighting.Brightness = 0.3
	Lighting.FogStart = 0
	Lighting.FogEnd = 100000
	Lighting.FogColor = Color3.fromRGB(60,60,70)

	local CutsceneFog = Instance.new("Atmosphere")
	CutsceneFog.Name = "CutsceneFog"
	CutsceneFog.Density = 0.75
	CutsceneFog.Offset = 0
	CutsceneFog.Color = Color3.fromRGB(120,120,130)
	CutsceneFog.Decay = Color3.fromRGB(70,70,80)
	CutsceneFog.Glare = 0
	CutsceneFog.Haze = 12
	CutsceneFog.Parent = Lighting

	Character.Archivable = true
	local clone = Character:Clone()
	Character.Archivable = false
	clone.Parent = Workspace

	local cloneHRP = clone:FindFirstChild("HumanoidRootPart")
	local cutsceneHRP = shinjiModel:FindFirstChild("CutsceneRig", true)
		and shinjiModel:FindFirstChild("CutsceneRig", true):FindFirstChild("HumanoidRootPart")

	if cutsceneHRP and cloneHRP then
		cloneHRP.CFrame = cutsceneHRP.CFrame
		cloneHRP.Anchored = true
	end

	local forest = AnimsFolder:FindFirstChild("Forest", true)
	local forestP2 = AnimsFolder:FindFirstChild("ForestP2", true)
	local forestP3 = AnimsFolder:FindFirstChild("ForestP3", true)

	task.spawn(function()

		local cloneForest = PlayKeyframeSequence(clone, forest, 1)
		task.wait(cloneForest.Length - 1.5)

		if cloneForest then
			cloneForest:Stop()
		end

		local warriorGrief = shinjiModel:FindFirstChild("WarriorGrief", true)

		if warriorGrief then
			for _, v in ipairs(warriorGrief:GetDescendants()) do
				if v:IsA("Sky")
					or v:IsA("ColorCorrectionEffect")
					or v:IsA("BloomEffect")
					or v:IsA("SunRaysEffect")
					or v:IsA("Atmosphere") then

					local effectClone = v:Clone()
					effectClone.Parent = Lighting
					table.insert(insertedEffects, effectClone)
				end
			end
		end

		local forestP2Anim = PlayKeyframeSequence(clone, forestP2, 1)
		task.wait(forestP2Anim.Length - 1.3)

		if forestP2Anim then
			forestP2Anim:Stop()
		end

		local forestP3Anim = PlayKeyframeSequence(clone, forestP3, 1)

		if forestP3Anim then
			task.wait(forestP3Anim.Length - 1)
			forestP3Anim:Stop()
		end

		for _, effect in ipairs(insertedEffects) do
			if effect and effect.Parent then
				effect:Destroy()
			end
		end

		if CutsceneFog and CutsceneFog.Parent then
			CutsceneFog:Destroy()
		end

		Lighting.ClockTime = originalLighting.ClockTime
		Lighting.Brightness = originalLighting.Brightness
		Lighting.FogStart = originalLighting.FogStart
		Lighting.FogEnd = originalLighting.FogEnd
		Lighting.FogColor = originalLighting.FogColor
		Lighting.Ambient = originalLighting.Ambient
		Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
	end)

	task.wait(15)

	if clone then
		clone:Destroy()
	end

	shinjiModel:Destroy()

	HRP.Anchored = false

	animAwakening:Stop()
	animAwakening:RestoreAnimator()

	Humanoid.WalkSpeed = originalSpeed

  loadstring(game:HttpGet("https://raw.githubusercontent.com/ian49972/SCRIPTS/refs/heads/main/IronS"))()
  loadstring(game:HttpGet("https://raw.githubusercontent.com/ian49972/SCRIPTS/refs/heads/main/LRampage"))()
  loadstring(game:HttpGet("https://raw.githubusercontent.com/ian49972/SCRIPTS/refs/heads/main/DracoMeteor"))()

	Debounce = false
end)
