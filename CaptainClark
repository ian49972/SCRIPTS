local function ResetAI()
	if simplePath.Status == SimplePath.StatusType.Active then
		simplePath:Stop()
	end

	humanoid:MoveTo(root.Position)

	task.wait(0.1)

	lastPosition = root.Position
	stuckTime = 0
end

RunService.Heartbeat:Connect(function()
	if not character.Parent then
		return
	end

	local distance = (hrp.Position - root.Position).Magnitude

if not caught then
	local moved = (root.Position - lastPosition).Magnitude

	if moved < 0.2 then
		stuckTime += RunService.Heartbeat:Wait()
	else
		stuckTime = 0
		lastPosition = root.Position
	end

	if stuckTime >= 3 then
		ResetAI()
	end
end

if distance <= 10 then
	CatchPlayer()
	return
end

if distance <= 40 then
	humanoid.WalkSpeed = 13
  walkSound.PlaybackSpeed = 1.2

	if not running then
		running = true
		currentAnim:Stop()
		currentAnim = PlayKeyframeSequence(npc, runAnim, 1)
	end
else
	humanoid.WalkSpeed = 4
  walkSound.PlaybackSpeed = 1

	if running then
		running = false
		currentAnim:Stop()
		currentAnim = PlayKeyframeSequence(npc, walkAnim, 1)
	end
end

local blocked = IsPathBlocked(root.Position, hrp.Position)

if blocked then
	simplePath:Run(hrp.Position)
else
	if simplePath.Status == SimplePath.StatusType.Active then
		simplePath:Stop()
	end

	humanoid:MoveTo(hrp.Position)
end
end)

