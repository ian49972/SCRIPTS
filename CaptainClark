local function IsPathBlocked(startPos, endPos)
	local direction = (endPos - startPos).Unit
	local distance = (endPos - startPos).Magnitude + 4

	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {npc}
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true

	return workspace:Raycast(
		startPos + Vector3.new(0,3,0),
		direction * distance,
		params
	) ~= nil
end

local SimplePath = {}
SimplePath.__index = SimplePath
 
SimplePath.StatusType = { Idle = "Idle"; Active = "Active"; }
SimplePath.ErrorType = { LimitReached = "LimitReached"; TargetUnreachable = "TargetUnreachable"; ComputationError = "ComputationError"; AgentStuck = "AgentStuck"; }
 
function SimplePath.new(agent)
	local self = setmetatable({
		_settings = {TIME_VARIANCE = 0.07; COMPARISON_CHECKS = 1; JUMP_WHEN_STUCK = true},
		_events = {
			Reached = Instance.new("BindableEvent"),
			WaypointReached = Instance.new("BindableEvent"),
			Blocked = Instance.new("BindableEvent"),
			Error = Instance.new("BindableEvent"),
			Stopped = Instance.new("BindableEvent"),
		},
		_agent = agent,
		_humanoid = agent:FindFirstChildOfClass("Humanoid"),
		_path = PathfindingService:CreatePath(),
		_status = SimplePath.StatusType.Idle,
		_t = 0,
	}, SimplePath)
	return self
end
 
function SimplePath:Stop()
	if self._status == SimplePath.StatusType.Idle then return end
	if self._moveConnection then self._moveConnection:Disconnect() end
	self._status = SimplePath.StatusType.Idle
	self._events.Stopped:Fire(self._agent)
end
 
function SimplePath:Run(target)
	if not (target and (typeof(target) == "Vector3" or target:IsA("BasePart"))) then return false end
 
	if os.clock() - self._t <= self._settings.TIME_VARIANCE and self._humanoid then
		task.wait(os.clock() - self._t)
		self._events.Error:Fire(SimplePath.ErrorType.LimitReached)
		return false
	end
	self._t = os.clock()
 
	local success = pcall(function()
		self._path:ComputeAsync(self._agent.PrimaryPart.Position, typeof(target) == "Vector3" and target or target.Position)
	end)
 
	if not success or self._path.Status == Enum.PathStatus.NoPath or #self._path:GetWaypoints() < 2 then
		self._events.Error:Fire(SimplePath.ErrorType.ComputationError)
		return false
	end
 
	self._status = SimplePath.StatusType.Active
	self._waypoints = self._path:GetWaypoints()
	self._currentWaypoint = 2
 
	if self._humanoid then
		if self._moveConnection then self._moveConnection:Disconnect() end
		self._moveConnection = self._humanoid.MoveToFinished:Connect(function(reached)
			if reached and self._currentWaypoint + 1 <= #self._waypoints then
				self._currentWaypoint += 1
				self._humanoid:MoveTo(self._waypoints[self._currentWaypoint].Position)
			elseif reached then
				if self._moveConnection then self._moveConnection:Disconnect() end
				self._status = SimplePath.StatusType.Idle
				self._events.Reached:Fire(self._agent, self._waypoints[self._currentWaypoint])
			else
				if self._moveConnection then self._moveConnection:Disconnect() end
				self._status = SimplePath.StatusType.Idle
				self._events.Error:Fire(SimplePath.ErrorType.TargetUnreachable)
			end
		end)
		self._humanoid:MoveTo(self._waypoints[self._currentWaypoint].Position)
	end
	return true
end

local simplePath = SimplePath.new(npc)

local lastPosition = root.Position
local stuckTime = 0

local function CatchPlayer()
	if caught then return end
	caught = true
  walkSound:Stop()

	if simplePath.Status == SimplePath.StatusType.Active then
		simplePath:Stop()
	end

	humanoid:MoveTo(root.Position)

	if currentAnim then
		currentAnim:Stop()
		currentAnim = nil
	end

	local character = player.Character
	if not character then return end

	local playerHRP = character:FindFirstChild("HumanoidRootPart")
	local playerHumanoid = character:FindFirstChildOfClass("Humanoid")

	if not playerHRP or not playerHumanoid then return end

	playerHRP.CFrame =
		root.CFrame *
		CFrame.new(0,-4, 0) *
		CFrame.Angles(0,math.rad(180),0)

	playerWeld = Instance.new("WeldConstraint")
	playerWeld.Part0 = root
	playerWeld.Part1 = playerHRP
	playerWeld.Parent = root

	killAnim = PlayKeyframeSequence(npc, killKF, 1)
	victimAnim = PlayKeyframeSequence(character, victimKF, 1)

