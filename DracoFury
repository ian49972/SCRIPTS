local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

local connections = {}

local function Connect(sig, fn)
	local c = sig:Connect(fn)
	table.insert(connections, c)
	return c
end

local function Cleanup()
	for _, c in ipairs(connections) do
		pcall(function() c:Disconnect() end)
	end
	connections = {}
end

player.CharacterAdded:Connect(function(c)
	Cleanup()
	character = c
	hrp = c:WaitForChild("HumanoidRootPart")
	humanoid = c:WaitForChild("Humanoid")
end)

player.CharacterRemoving:Connect(Cleanup)

local tool = Instance.new("Tool")
tool.Name = "Dragon's Fury"
tool.RequiresHandle = false
tool.Parent = player:WaitForChild("Backpack")

local asset = game:GetObjects(getcustomasset("MArtist.rbxmx"))[1]
asset.Parent = game.ReplicatedStorage

local Anims = asset:WaitForChild("Anims")
local DFuryKS = Anims:WaitForChild("DFury")

loadstring(game:HttpGet("https://raw.githubusercontent.com/ian49972/Animator/refs/heads/main/RobAnimator"))()

local function enableParticles(obj)
	for _, v in ipairs(obj:GetDescendants()) do
		if v:IsA("ParticleEmitter") then
			v.Enabled = true
		end
	end
end

tool.Activated:Connect(function()

	Cleanup()

	if not character or not character.Parent then return end

	local hrp = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChild("Humanoid")
	if not hrp or not humanoid then return end

	local originalSpeed = humanoid.WalkSpeed
	humanoid.WalkSpeed = 0

	local animator = humanoid:FindFirstChild("Animator")
	if animator then animator:Destroy() end

	local sound = Instance.new("Sound")
	sound.SoundId = getcustomasset("DFury.mp3")
	sound.Volume = 1
	sound.Parent = workspace
	sound:Play()

	local anim = PlayKeyframeSequence(character, DFuryKS, 1)

	local black = asset:FindFirstChild("Black", true):Clone()
	local white = asset:FindFirstChild("White", true):Clone()

	black.Parent = workspace
	white.Parent = workspace

	black.Anchored = true
	white.Anchored = true
	black.CanCollide = false
	white.CanCollide = false

	task.delay(5, function()

		local base = hrp.CFrame
		black.CFrame = base * CFrame.new(-20, 40, 0)
		white.CFrame = base * CFrame.new(20, 40, 0)

		task.wait(1)

		local start = os.clock()
		local orbitRadius = 20
		local orbitSpeed = 3
		local fallSpeed = 10
		local active = true

		local conn
		conn = RunService.Heartbeat:Connect(function()

			if not active then return end

			local t = os.clock() - start
			local y = 40 - (t * fallSpeed)

			local angle = t * orbitSpeed

			local function orbit(offset, phase)
				return hrp.CFrame *
					CFrame.new(
						math.cos(angle + phase) * orbitRadius + offset.X,
						math.max(y, 10),
						math.sin(angle + phase) * orbitRadius + offset.Z
					)
			end

			black.CFrame = orbit(Vector3.new(-6, 0, 0), 0)
			white.CFrame = orbit(Vector3.new(6, 0, 0), math.pi)

			if y <= 10 then
				active = false
				conn:Disconnect()

				task.wait(1)

				local slam1 = TweenService:Create(black, TweenInfo.new(0.2), {
					CFrame = hrp.CFrame
				})

				local slam2 = TweenService:Create(white, TweenInfo.new(0.2), {
					CFrame = hrp.CFrame
				})

				slam1:Play()
				slam2:Play()

				slam1.Completed:Wait()

